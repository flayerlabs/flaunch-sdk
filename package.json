{
  "name": "@flaunch/sdk",
  "version": "1.0.0-next.0",
  "description": "Flaunch V3 SDK: launch, swap, claim and stake on Flaunch V3 with viem",
  "license": "MIT",
  "type": "module",
  "author": "Apoorv Lathey <apoorv@flayer.io>",
  "homepage": "https://github.com/flayerlabs/flaunch-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flayerlabs/flaunch-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/flayerlabs/flaunch-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "flaunch",
    "launchpad",
    "uniswap",
    "uniswap v4",
    "viem",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build",
    "test": "pnpm build && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:package": "node scripts/test-package.mjs",
    "generate:abis": "node scripts/generate-abis.mjs",
    "smoke": "node scripts/testnet-smoke.mjs"
  },
  "packageManager": "pnpm@10.34.3",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "rimraf": "^6.0.1",
    "rollup": "^2.75.6",
    "tslib": "^2.4.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "viem": "^2.55.2"
  }
}
