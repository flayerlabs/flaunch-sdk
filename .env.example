# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Used only by `scripts/validate-multichain-deployments.mjs`, which verifies the
# multichain contract addresses in `src/addresses.ts` are actually deployed and
# wired together on-chain. Not needed to build, test, or publish the SDK.
#
# NOTE: the script reads process.env directly and does NOT load .env itself.
# See "Running the validator" below.
#
# Any standard JSON-RPC HTTPS endpoint works (Alchemy, Infura, QuickNode, or a
# public RPC). The script issues ~10 eth_getCode/eth_call reads per chain, so a
# free-tier key is plenty. Read-only: no private keys, no funds required.

# Ethereum mainnet (chain ID 1)
ETHEREUM_RPC_URL=

# Unichain (chain ID 130)
UNICHAIN_RPC_URL=

# Robinhood Chain (chain ID 4663)
ROBINHOOD_RPC_URL=

# Running the validator
# ---------------------
# `pnpm validate:multichain` does NOT pick up this file. Either export the vars
# into your shell:
#
#   set -a && source .env && set +a && pnpm validate:multichain
#
# or run the script with Node's built-in env-file flag (Node >= 20.6):
#
#   pnpm build && node --env-file=.env scripts/validate-multichain-deployments.mjs
